BOT_TOKEN=your_bot_token_here
DATABASE_PATH=data/bot.db

# ID супергруппы вида -1001234567890. Предпочтительнее username.
PROJECTS_CHAT_ID=0
# Можно использовать @GolangGopher, если бот умеет писать в группу.
PROJECTS_CHAT_USERNAME=@GolangGopher
PROJECTS_THREAD_ID=5

# Сеть языковых групп. Для каждого языка задаются группа и ID темы «Ваши проекты».
# PROJECT_GROUPS_JSON=[{"language":"Go","chat_id":-1004494598650,"chat_username":"@GolangGopher","thread_id":5},{"language":"Python","chat_id":-1001234567890,"chat_username":"@PythonGroup","thread_id":5}]

# Единый канал-лента всех проектов. Бот должен быть администратором канала.
PROJECTS_CHANNEL_ID=0
PROJECTS_CHANNEL_USERNAME=@AllDevProjects

# Telegram ID администраторов через запятую.
ADMIN_IDS=123456789
GITHUB_TOKEN=
